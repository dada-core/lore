# Lore settings. Documentation: https://lore.dada-core.com/docs/environment-variables/
# One VARIABLE=value per line. Put a value in single quotes if it contains spaces or special characters
# (on Windows, with lore.cmd, use double quotes instead: single quotes would become part of the value).

# Address at which your team opens Lore: used in invitation and password reset links.
LORE_PUBLIC_URL=http://localhost:8080
# Port on which Lore answers.
LORE_PORT=8080

# PostgreSQL 18 database.
LORE_DB_HOST=localhost
LORE_DB_PORT=5432
LORE_DB_NAME=lore
LORE_DB_USER=lore
LORE_DB_PASSWORD=

# Optional settings.
# Fixed initial setup code, for automated installations (otherwise printed in the logs):
# LORE_SETUP_CODE=
# LORE_SESSION_TIMEOUT=8h
# LORE_LOG_LEVEL=INFO
# Java options, for example the maximum memory: -Xmx2g
# LORE_JAVA_OPTS=-XX:MaxRAMPercentage=25

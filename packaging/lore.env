# Lore settings. Documentation: https://lore.dada-core.com/docs/environment-variables/
# One VARIABLE=value per line. Put a value in single quotes if it contains spaces or special characters
# (on Windows, with lore.cmd, use double quotes instead: single quotes would become part of the value).

# Address at which your team opens Lore: used in invitation and password reset links.
LORE_PUBLIC_URL=http://localhost:8080
# Port on which Lore answers.
LORE_PORT=8080

# PostgreSQL 18 database.
LORE_DB_HOST=localhost
LORE_DB_PORT=5432
LORE_DB_NAME=lore
LORE_DB_USER=lore
LORE_DB_PASSWORD=

# Optional settings.
# Fixed initial setup code, for automated installations (otherwise printed in the logs):
# LORE_SETUP_CODE=
# LORE_SESSION_TIMEOUT=8h
# LORE_LOG_LEVEL=INFO
# Folder of the imported files (packages: /var/lib/lore/files; archive: data/files next to bin/).
# With the packages, a folder outside /var/lib/lore must also be added to ReadWritePaths.
# LORE_FILES_PATH=
# Ceiling of the size of an imported file; administrators choose the size in force below it
# (50 MB by default):
# LORE_MAX_UPLOAD_SIZE=1GB
# Text extraction: processes at the same time, longest extraction of a file, memory of a process.
# Each process takes up to its memory plus about 150 MB: below 4 GB of memory, keep one.
# LORE_EXTRACTION_WORKERS=2
# LORE_EXTRACTION_TIMEOUT=120s
# LORE_EXTRACTION_MEMORY=512MB
# Java options, for example the maximum memory: -Xmx2g
# LORE_JAVA_OPTS=-XX:MaxRAMPercentage=25
